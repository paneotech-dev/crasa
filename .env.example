# CRASA — environment template.
#
# Every key the application reads is in this file: active below where this
# platform uses it, commented in the reference block at the end where only the
# framework's stock configuration reads it. tests/Feature/EnvExampleTest.php
# fails if a key is read anywhere and listed nowhere here.
#
# docs/REBUILD.md section 4 gives the production value of every active key.
# Never copy a value from an old server, and never commit a filled-in copy.

APP_NAME=CRASA
APP_ENV=local
APP_KEY=
# Old keys, comma-separated, kept only while rotating APP_KEY. Empty normally.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development and the test suite use SQLite. Production is MariaDB 10.11:
# set DB_CONNECTION=mysql and uncomment the block below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=crasa
# DB_USERNAME=crasa
# DB_PASSWORD=
# The connection clock. Stored times are UTC whatever the server zone.
# DB_TIMEZONE=+00:00
# The empty schema backup:rehearse restores into. See docs/SCRATCH_SCHEMA.md.
# DB_REHEARSAL_DATABASE=crasa_rehearsal

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure by default. Local development over plain http needs false, or no
# session survives the next request.
SESSION_SECURE_COOKIE=true
# Lax: a link opened from Teams or an email arrives signed in. Strict did not.
SESSION_SAME_SITE=lax
# Distinct per installation, so two applications on one host never share it.
SESSION_COOKIE=crasa_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_PUBLIC_URL=/storage
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=crasa-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outbound mail. docs/MAIL_SETUP.md. With the log driver nothing is delivered
# and the back office shows a red banner saying so.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@crasa.org"
MAIL_FROM_NAME="CRASA"

# Off-site backup bucket. docs/BACKUP_SETUP.md. AWS_ENDPOINT only for an
# S3-compatible provider that is not AWS itself.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
AWS_URL=

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# CRASA's own settings (config/crasa.php). The values shown are the defaults.
# ---------------------------------------------------------------------------

# Who receives contact-form enquiries. The default is the Secretariat's real
# inbox: on a development or demonstration host, point this at a test mailbox
# before mail is connected, or every test enquiry reaches CRASA.
# CRASA_ENQUIRY_RECIPIENT=crasa@crasa.org
CRASA_TIMEZONE=Africa/Gaborone
# Two-factor is required for administrators. false only for a demonstration.
CRASA_TWO_FACTOR_REQUIRED=true
# Demonstration hosts only: keep search engines out (robots meta tag and
# X-Robots-Tag header). Remove at go-live.
CRASA_NOINDEX=false
# Log "mail is not being delivered" on every boot while MAIL_MAILER is log.
CRASA_MAIL_LOG_WARNING=true
# Role guide opened by the help icon in the back office and member area.
CRASA_ROLE_GUIDE_URL=https://workshopcrasa.paneo.tech/training.html
CRASA_SEARCH_DRIVER=database
# Folder on the private disk that holds member-area documents.
CRASA_DOCUMENTS_DIR=extranet
CRASA_MAP_LAT=-24.6282
CRASA_MAP_LNG=25.9231
CRASA_MAP_TILES="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# ---------------------------------------------------------------------------
# Reference only. Read by Laravel's stock configuration for drivers and
# features this platform does not use. Listed so the file is complete; leave
# them commented unless you switch to the driver concerned.
# ---------------------------------------------------------------------------

# Authentication
# AUTH_GUARD=web
# AUTH_MODEL=App\Models\User
# AUTH_PASSWORD_BROKER=users
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# AUTH_PASSWORD_TIMEOUT=10800

# Database connection detail
# DB_URL=
# DB_SOCKET=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# DB_FOREIGN_KEYS=true
# DB_SSLMODE=prefer
# DB_ENCRYPT=
# DB_TRUST_SERVER_CERTIFICATE=
# MYSQL_ATTR_SSL_CA=

# Database-backed cache, queue and session tables
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90
# QUEUE_FAILED_DRIVER=database-uuids
# SESSION_CONNECTION=
# SESSION_TABLE=sessions
# SESSION_STORE=
# SESSION_EXPIRE_ON_CLOSE=false
# SESSION_HTTP_ONLY=true
# SESSION_PARTITIONED_COOKIE=false

# File cache
# CACHE_STORAGE_DISK=
# CACHE_STORAGE_PATH=

# Logging channels
# LOG_DAILY_DAYS=14
# LOG_DEPRECATIONS_TRACE=false
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=
# LOG_PAPERTRAIL_HANDLER=
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME=
# LOG_SLACK_EMOJI=

# Mail transports
# MAIL_URL=
# MAIL_EHLO_DOMAIN=
# MAIL_LOG_CHANNEL=
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# POSTMARK_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=
# RESEND_API_KEY=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# Cloudflare Turnstile on the public forms (contact, meeting registration,
# sign-in, password reset). Both set turns it on; either empty leaves the
# forms on their honeypot and rate limits alone.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Memcached
# MEMCACHED_PERSISTENT_ID=
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PORT=11211

# Redis
# REDIS_URL=
# REDIS_USERNAME=
# REDIS_CLUSTER=redis
# REDIS_PREFIX=crasa-database-
# REDIS_PERSISTENT=false
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90
# REDIS_MAX_RETRIES=3
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
# REDIS_BACKOFF_BASE=100
# REDIS_BACKOFF_CAP=1000

# Other queue and cache backends
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90
# SQS_PREFIX=
# SQS_QUEUE=default
# SQS_SUFFIX=
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=

# Machine translation on approval (item 1b): none or deepl
CRASA_MT_DRIVER=none
DEEPL_API_KEY=
